{
  "name": "kaboom-ahoy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx sim/cli.ts",
    "assets:check": "tsx scripts/assets-check.ts",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/preferences": "^7.0.4",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "@preact/signals-core": "^1.14.5",
    "pixi.js": "^8.23.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
